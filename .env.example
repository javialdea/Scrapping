# Copia este archivo como .env para probar el envío en tu ordenador (.env no se sube a git).
# En GitHub Actions estos valores van como secretos del repositorio.
GMAIL_USUARIO=cuenta-de-envio@gmail.com
GMAIL_CONTRASENA_APP=xxxx xxxx xxxx xxxx
CORREO_DESTINO=tu-correo@outlook.com
# Pon "no" para no recibir correo los días sin novedades
ENVIAR_SIN_NOVEDADES=si
